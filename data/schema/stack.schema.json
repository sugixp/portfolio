{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stack",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "$ref": "common.schema.json#/$defs/localized" },
          "items": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "minItems": 1,
            "uniqueItems": true
          },
          "planned": {
            "description": "Marks technologies still being learned.",
            "type": "boolean"
          }
        },
        "required": ["id", "title", "items"],
        "additionalProperties": false
      }
    }
  },
  "required": ["groups"],
  "additionalProperties": false
}
