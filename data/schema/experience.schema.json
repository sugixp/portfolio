{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experience",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "experience": {
      "description": "Most recent first.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "string", "pattern": "^\\d{4}$" },
          "end": {
            "description": "null means the role is current.",
            "type": ["string", "null"],
            "pattern": "^\\d{4}$"
          },
          "title": { "$ref": "common.schema.json#/$defs/localized" },
          "description": { "$ref": "common.schema.json#/$defs/localized" }
        },
        "required": ["start", "end", "title", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["experience"],
  "additionalProperties": false
}
