{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experience",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "experience": {
      "description": "Most recent first.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "end": {
            "description": "null means the role is current.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}$"
          },
          "expectedEnd": {
            "description": "Expected completion while end is null (e.g. a degree in progress): \"2027\" or \"2027-12\". Shown as \"2025 – expected Dec 2027\".",
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "kind": {
            "description": "\"education\" goes to the Education section of the CV; anything else (default \"work\") to Experience. The site timeline shows both.",
            "enum": [
              "work",
              "education"
            ]
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localized"
          }
        },
        "required": [
          "start",
          "end",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "experience"
  ],
  "additionalProperties": false
}
