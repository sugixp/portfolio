{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub data",
  "description": "Generated by scripts/fetch-github.mjs. Do not edit by hand.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "user": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "type": ["string", "null"] },
          "url": { "$ref": "common.schema.json#/$defs/url" },
          "homepage": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "stars": { "type": "integer", "minimum": 0 },
          "archived": { "type": "boolean" },
          "lastCommit": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "sha": { "type": "string" },
                  "date": { "type": "string", "format": "date-time" },
                  "message": { "type": "string" }
                },
                "required": ["sha", "date", "message"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["name", "url", "language", "stars", "archived", "lastCommit"],
        "additionalProperties": false
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "share": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["name", "bytes", "share"],
        "additionalProperties": false
      }
    },
    "recentActivity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "enum": ["push", "create", "pull-request", "release", "publish"] },
          "repo": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "commits": { "type": "integer", "minimum": 0 }
        },
        "required": ["type", "repo", "date"],
        "additionalProperties": false
      }
    }
  },
  "required": ["user", "repos", "languages", "recentActivity"],
  "additionalProperties": false
}
